---
import BaseLayout from '../layouts/BaseLayout.astro';
import Projects from '../components/Projects.astro';
import Timeline from '../components/Timeline.astro';
import { Image } from 'astro:assets';
import atharvaPhoto from '../assets/atharva.png';
import { BIO, PROJECTS_INTRO, SITE } from '../consts';

export const prerender = true;
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="hero container">
    <div class="hero__inner">
      <Image
        src={atharvaPhoto}
        alt=""
        class="hero__photo fade-in fade-in--2"
        widths={[320, 640]}
        sizes="180px"
        loading="eager"
      />
      <div class="hero__content">
        <h1 class="sr-only">{SITE.title}</h1>
        <p class="hero__lede fade-in fade-in--3">{BIO}</p>
      </div>
    </div>
  </section>

  <section class="section container" aria-label="Timeline">
    <Timeline />
  </section>

  <section class="section container" aria-labelledby="projects">
    <h2 id="projects" class="section__title">Projects</h2>
    <p class="section__intro">
      {PROJECTS_INTRO} For all my results of inquisitiveness, see my{' '}
      <a href={SITE.github}>GitHub</a>.
    </p>
    <Projects />
  </section>
</BaseLayout>
