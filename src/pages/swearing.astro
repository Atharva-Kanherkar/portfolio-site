---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

// TiltBench. every AI benchmark ranks the models. this one ranks me: how often
// i lost it and swore/shouted at a coding agent. a panel of agents read every
// message (no keyword matching) and flagged the genuine meltdowns. excited
// "this is fire" does not count. "ARE YOU BLIND" counts.
//
// total = human messages per model (the denominator). n = genuine meltdowns.
// rate = n per 1,000 messages, the only fair metric since i use some models
// way more than others.

type Row = {
  model: string;
  harness: string;
  total: number;
  n: number;
  avg: number;
  rage: number;
  swearing: number;
  shouting: number;
  angry: number;
  exasperated: number;
};

const rows: Row[] = [
  { model: 'gpt-5.x', harness: 'Codex', total: 889, n: 13, avg: 2.08, rage: 2, swearing: 5, shouting: 0, angry: 9, exasperated: 9 },
  { model: 'claude-opus-4-8', harness: 'Claude Code', total: 7143, n: 67, avg: 1.93, rage: 8, swearing: 29, shouting: 3, angry: 37, exasperated: 57 },
  { model: 'claude-sonnet-4-6', harness: 'Claude Code', total: 629, n: 3, avg: 1.67, rage: 0, swearing: 0, shouting: 1, angry: 2, exasperated: 3 },
  { model: 'claude-fable-5', harness: 'Claude Code', total: 846, n: 4, avg: 1.75, rage: 0, swearing: 2, shouting: 0, angry: 3, exasperated: 3 },
  { model: 'claude-haiku-4-5', harness: 'Claude Code', total: 2280, n: 1, avg: 1.0, rage: 0, swearing: 0, shouting: 0, angry: 0, exasperated: 1 },
];

const withRate = rows
  .map((r) => ({ ...r, rate: (r.n / r.total) * 1000 }))
  .sort((a, b) => b.rate - a.rate);

const maxRate = Math.max(...withRate.map((r) => r.rate));

const totalReviewed = rows.reduce((s, r) => s + r.total, 0);
const totalFrustrated = rows.reduce((s, r) => s + r.n, 0);

// intensity to ink density (%) for the meltdown cell. theme-aware via color-mix.
const heat = (v: number) => Math.round((0.14 + (Math.min(v, 3) / 3) * 0.72) * 100);

// receipts. verbatim, typos intact (i was typing angry). only the spiciest
// letters censored.
const evidence = [
  {
    model: 'claude-opus-4-8',
    tag: 'full caps meltdown',
    quote: 'PLEASE F***ING LOOK AT WHAT YOU HAVE MADE. IT IS ABSOLUTELY SHIT. I CAN NOT READ THE TEXT. ARE YOU F***ING BLIND',
  },
  {
    model: 'gpt-5.x',
    tag: 'unhinged',
    quote: "its a f***ing hobby project. why the f*** are you questioning me like youre my f***ing boss?",
  },
  {
    model: 'claude-opus-4-8',
    tag: 'character assassination',
    quote: 'What the f*** man. Are you like really dumb? ... are you like just a f***ing lazy sick f***?',
  },
  {
    model: 'gpt-5.x',
    tag: 'condescension arc',
    quote: "Bro for god's sake... are you really that dumb, lol?",
  },
  {
    model: 'claude-opus-4-8',
    tag: 'do your job',
    quote: "Don't f***ing school me. Tell me each last commit... that is your job.",
  },
  {
    model: 'claude-haiku-4-5',
    tag: 'the one (1) time i was chill',
    quote: 'Can you not generate scripts better, just use a subagent... fuzzy logic or matching wont result in semantic meanings',
  },
];

const pct = (x: number) => `${((x / maxRate) * 100).toFixed(1)}%`;
const fmtRate = (x: number) => x.toFixed(1);
---

<BaseLayout
  title="TiltBench"
  description="Every AI benchmark ranks the models. This one ranks me: how many times I lost it and swore or shouted at a coding agent, read from every transcript and sorted by model. Spoiler, it was a lot."
>
  <article class="kbench container container--wide">
    <header class="kbench__head">
      <p class="eyebrow">The one benchmark where I'm the thing being tested</p>
      <h1 class="kbench__title">TiltBench</h1>
      <p class="kbench__sub">a leaderboard of me losing it at robots</p>
      <div class="kbench__lede prose">
        <p>
          Every AI benchmark ranks the models. This one ranks <em>me</em>. Specifically: how often I
          completely lost the plot and started swearing at a coding agent like it keyed my car.
        </p>
        <p>
          A panel of agents read all <strong>{totalReviewed.toLocaleString()}</strong> of my
          messages across Claude Code, Codex and Cursor so you don't have to, and counted the
          <strong> {totalFrustrated}</strong> times I genuinely popped off. Not "this is fire"
          popped off. "ARE YOU BLIND" popped off. No keyword matching, they actually read it. Yes
          it's embarrassing. No I will not be taking questions.
        </p>
      </div>
      <dl class="kbench__meta">
        <div><dt>Messages read</dt><dd>{totalReviewed.toLocaleString()}</dd></div>
        <div><dt>Times I lost it</dt><dd>{totalFrustrated}</dd></div>
        <div><dt>Harnesses</dt><dd>3</dd></div>
        <div><dt>Regrets</dt><dd>0</dd></div>
      </dl>
    </header>

    <section aria-labelledby="board-title">
      <h2 id="board-title" class="kbench__section-title">Ranked by how fast each model made me snap</h2>
      <p class="kbench__note-inline">
        Rate is tantrums per 1,000 messages. Ranking by raw count would just crown whatever model I
        use most, which isn't a benchmark, it's a diary. This is the fair version.
      </p>

      <div class="kbench__scroll">
        <table class="kbench__table">
          <thead>
            <tr>
              <th class="c"></th>
              <th class="l">Model</th>
              <th class="l">Rage rate · per 1k</th>
              <th class="c">Tantrums</th>
              <th class="c">Msgs</th>
              <th class="c">Swore</th>
              <th class="c">Caps</th>
              <th class="c">At&nbsp;it</th>
              <th class="c">Done</th>
              <th class="c">Meltdown</th>
            </tr>
          </thead>
          <tbody>
            {
              withRate.map((r, i) => (
                <tr>
                  <td class="rank">{i + 1}</td>
                  <td class="model">
                    <span class="model__name">{r.model}</span>
                    <span class="model__tag">{r.harness}</span>
                  </td>
                  <td class="rate">
                    <span class="barwrap">
                      <span class="bar" style={`width:${pct(r.rate)}`} />
                    </span>
                    <span class="rate__val">{fmtRate(r.rate)}</span>
                  </td>
                  <td class="c num strong">{r.n}</td>
                  <td class="c num dim">{r.total.toLocaleString()}</td>
                  <td class="c num">{r.swearing || <span class="zero">·</span>}</td>
                  <td class="c num">{r.shouting || <span class="zero">·</span>}</td>
                  <td class="c num">{r.angry || <span class="zero">·</span>}</td>
                  <td class="c num">{r.exasperated || <span class="zero">·</span>}</td>
                  <td class="c meltdown">
                    <span class="meltdot" style={`background:color-mix(in srgb, var(--ink) ${heat(r.avg)}%, transparent)`} />
                    <span class="meltdown__val">{r.avg.toFixed(2)}</span>
                    {r.rage > 0 && <span class="meltdown__rage">{r.rage} full ragequits</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="kbench__takeaway">
        Raw numbers say <strong>opus-4-8</strong> is the villain. Nah, that's just my main, I talk
        to it 7k times so of course it caught the most strays. Adjusted for volume,
        <strong> Codex / gpt-5.x</strong> speedran my patience the hardest. And
        <strong> haiku-4-5</strong>? 2,280 messages, one (1) mild grumble. Gigachad. Zen master.
        Genuinely never did anything wrong in its life. Protect it at all costs.
      </p>
    </section>

    <section class="kbench__evidence" aria-labelledby="ev-title">
      <h2 id="ev-title" class="kbench__section-title">Receipts</h2>
      <p class="kbench__note-inline">
        Verbatim, typos included (I was typing angry), only the spiciest letters censored so this
        stays technically SFW. This is what "lost it" actually looked like. It's not my proudest
        work.
      </p>
      <ul class="quotes">
        {
          evidence.map((e) => (
            <li class="quote">
              <blockquote class="quote__text">{e.quote}</blockquote>
              <p class="quote__attr">
                <span class="quote__model">{e.model}</span>
                <span class="quote__tag">{e.tag}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="kbench__method">
      <h2 class="kbench__section-title">How this was made (for the nerds)</h2>
      <p>
        Every JSONL transcript under Claude Code and Codex, plus Cursor's chat sessions, got parsed
        for messages I actually typed, each tagged with the model that answered. Then twelve agents
        read all {totalReviewed.toLocaleString()} of them in parallel and judged the vibe: a message
        only counts if it's genuine anger, swearing out of frustration, caps-lock shouting, or me
        being fully done with the agent. Never a keyword hit. Intensity is 1 to 3, the meltdown dot
        shows the average with a count of full 3/3 ragequits. Sorted by model across all three
        harnesses. Cursor gave one usable message and zero tantrums, so, respect.
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .kbench {
    padding-bottom: var(--space-2xl);
  }

  .kbench__head {
    padding: var(--space-xl) 0 var(--space-lg);
  }

  .kbench__title {
    font-size: var(--text-hero);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0.35rem 0 0.4rem;
  }

  .kbench__sub {
    font-size: var(--text-lg);
    color: var(--ink-muted);
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-md);
  }

  .kbench__lede {
    max-width: 58ch;
  }

  .kbench__lede em {
    font-style: italic;
  }

  .kbench__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin: var(--space-lg) 0 0;
    padding: var(--space-md) 0 0;
    border-top: 1px solid var(--rule);
  }

  .kbench__meta div {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .kbench__meta dt {
    font-size: var(--text-sm);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .kbench__meta dd {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .kbench__section-title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: var(--space-2xl) 0 var(--space-sm);
  }

  .kbench__note-inline {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-soft);
    max-width: 62ch;
    margin: 0 0 var(--space-lg);
  }

  .kbench__scroll {
    overflow-x: auto;
    margin: 0 calc(-1 * var(--page-gutter));
    padding: 0 var(--page-gutter);
  }

  .kbench__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
    min-width: 44rem;
  }

  .kbench__table th {
    color: var(--ink-muted);
    font-weight: 500;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 0 0.5rem 0.9rem;
    white-space: nowrap;
    vertical-align: bottom;
  }

  .kbench__table th.l {
    text-align: left;
  }

  .kbench__table td {
    padding: 0.95rem 0.5rem;
    border-top: 1px solid var(--rule);
    vertical-align: middle;
  }

  .kbench__table td.c {
    text-align: center;
  }

  .num {
    font-variant-numeric: tabular-nums;
  }

  .rank {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--ink-faint);
    text-align: center;
    width: 2.25rem;
    font-variant-numeric: tabular-nums;
  }

  .model {
    min-width: 11rem;
  }

  .model__name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .model__tag {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.1rem 0.5rem;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
  }

  .rate {
    min-width: 12rem;
    white-space: nowrap;
  }

  .barwrap {
    display: inline-block;
    vertical-align: middle;
    width: 8rem;
    height: 0.5rem;
    background: var(--paper-deep);
    border-radius: 999px;
    overflow: hidden;
  }

  .bar {
    display: block;
    height: 100%;
    background: var(--ink);
    border-radius: 999px;
  }

  .rate__val {
    margin-left: 0.7rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .strong {
    font-weight: 600;
    color: var(--ink);
  }

  .dim {
    color: var(--ink-faint);
  }

  .zero {
    color: var(--ink-faint);
  }

  .meltdown {
    white-space: nowrap;
  }

  .meltdot {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    vertical-align: -0.05em;
    border: 1px solid var(--rule-strong);
  }

  .meltdown__val {
    margin-left: 0.45rem;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .meltdown__rage {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  .kbench__takeaway {
    margin: var(--space-lg) 0 0;
    padding: var(--space-md);
    background: var(--paper-deep);
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--ink-soft);
    max-width: 66ch;
  }

  .kbench__takeaway strong {
    color: var(--ink);
    font-weight: 600;
  }

  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-md);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--rule-strong);
    border-radius: 4px;
    background: var(--paper);
  }

  .quote__text {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .quote__attr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: auto 0 0;
  }

  .quote__model {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .quote__tag {
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .kbench__method {
    margin-top: var(--space-lg);
    max-width: 70ch;
  }

  .kbench__method p {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 640px) {
    .quotes {
      grid-template-columns: 1fr;
    }

    .kbench__meta {
      gap: var(--space-md) var(--space-lg);
    }
  }
</style>
